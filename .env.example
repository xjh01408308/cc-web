# ===== cc-web 配置文件 =====
# 复制此文件为 .env 后修改: cp .env.example .env

# 环境模式: development (默认) 或 production
# production 模式下强制要求 RELAY_BROWSER_TOKEN 和自定义 RELAY_TOKEN
NODE_ENV=production

# ----- 中继服务 (packages/relay) -----
# 中继 HTTP/WS 监听端口
RELAY_PORT=3001
# 本地服务注册认证 token（中继与本地需一致）
# ⚠️ 生产环境必须修改此值，不能使用默认的 dev-token
RELAY_TOKEN=<生成一个强随机字符串>
# 浏览器 WebSocket 认证 token（留空则不启用认证）
# 设置后，前端连接需携带此 token，否则连接被拒绝
# 同时需要设置 VITE_BROWSER_TOKEN 为相同值供前端使用
# ⚠️ 生产环境（NODE_ENV=production）必须设置此值
RELAY_BROWSER_TOKEN=<生成一个强随机字符串>
# 前端静态文件目录（相对 relay 包的路径）
STATIC_DIR=../../frontend/dist

# ----- 本地服务 (packages/local) -----
# 中转服务 WebSocket 地址
# 同机器部署（推荐）: ws://127.0.0.1:3001/ws/local（本机回环，无需 TLS）
# 跨机器部署（需要 nginx 代理 WSS）: wss://your-domain.com/ws/local
RELAY_URL=ws://127.0.0.1:3001/ws/local
# 节点标识（留空则自动使用本机 hostname）
NODE_ID=
# 节点登录密码（留空则不启用密码认证）
# ⚠️ 公网部署时强烈建议设置此值
NODE_PASSWORD=
# 项目工作区根目录（留空则不限制路径）
# 设置后，create_project 的路径必须在此目录下
# 例如: WORKSPACE_ROOT=C:/projects
WORKSPACE_ROOT=
# WebSocket 重连初始延迟（毫秒）
RECONNECT_DELAY=2000
# WebSocket 重连最大延迟（毫秒）
MAX_RECONNECT_DELAY=30000
# 强制锁定权限模式，忽略前端传的值（留空 = 以前端为准）
# 支持的模式: bypassPermissions | acceptEdits | default | plan
CLAUDE_FORCE_PERMISSION_MODE=

# ----- 前端 (packages/frontend) -----
# 浏览器 WebSocket token（需与 RELAY_BROWSER_TOKEN 一致，仅在启用浏览器认证时设置）
# Vite 构建时注入到前端代码中
VITE_BROWSER_TOKEN=<与 RELAY_BROWSER_TOKEN 相同的值>
#
# 浏览器 WebSocket 地址（通常留空，前端会根据页面协议自动选择 ws/wss）
# 仅在非标准部署（如前端和 nginx 不在同一域名）时需要手动指定
# VITE_WS_URL=wss://your-domain.com/ws/browser
