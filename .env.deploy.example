# 部署目标配置（本机 → 远程服务器）
# 复制为 .env.deploy 并填写；.env.deploy 已在 .gitignore 中，不会提交。

DEPLOY_HOST=115.191.34.123   # 远程服务器地址
DEPLOY_USER=root             # ssh 登录用户
DEPLOY_KEY=                  # ssh 私钥路径；留空则用 ssh-agent / ~/.ssh 默认密钥
DEPLOY_PATH=/opt/cc-web      # 服务器上【现有】cc-web 部署目录（含已配好的 packages/relay/.env 与 data/）
DEPLOY_INITIAL_ADMIN_PASSWORD=   # 仅首次全新部署需要：relay admin 初始密码（登录后请改）；服务器已有 .env 则忽略
