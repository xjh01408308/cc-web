# ===== relay 配置 =====
# 复制此文件为 .env 后修改: cp .env.example .env

# 环境模式: development (默认) 或 production
# production 模式下强制要求自定义 RELAY_TOKEN
NODE_ENV=production

# 中继 HTTP/WS 监听端口
RELAY_PORT=3001
# 本地服务注册认证 token（须与 packages/local/.env 中的 RELAY_TOKEN 一致）
# ⚠️ 生产环境必须修改此值，不能使用默认的 dev-token
RELAY_TOKEN=<生成一个强随机字符串>
# 首 admin 种子（仅 users 表为空时创建一次）
# Relay 首启时据此幂等创建首个管理员账户，用于浏览器登录（用户名 + 密码）
INITIAL_ADMIN_USER=admin
INITIAL_ADMIN_PASSWORD=<设置一个管理员密码>
# 前端静态文件目录（相对 relay 包的路径）
STATIC_DIR=../../frontend/dist
